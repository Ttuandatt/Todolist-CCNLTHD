# =========================================================================
# TodoList Fullstack - Environment Variables Configuration Template
# =========================================================================

# --- DATABASE (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=CCNLTHD_postgres

# This URL is used by Prisma in the Backend. 
# Note: In Docker Compose, 'postgres' is the hostname.
DATABASE_URL=postgresql://postgres:123@postgres:5432/CCNLTHD_postgres?schema=public

# --- REDIS (for BullMQ) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- AUTHENTICATION (JWT) ---
JWT_SECRET=change_me_to_a_strong_secret
JWT_REFRESH_SECRET=change_me_to_another_strong_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- FRONTEND ---
# (Optional) Add frontend-specific env variables here if needed
# Example: VITE_API_BASE_URL=http://localhost:3333/api
